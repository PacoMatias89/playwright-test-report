{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "node"
    ]
  },
"include": [
  "tests/**/*.ts",
  "pages/**/*.ts",
  "fixtures/**/*.ts",
  "utils/**/*.ts",
  "config/**/*.ts",
  "test-data/*/*.ts"
]
}